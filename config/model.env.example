# OpenAI-compatible chat completion endpoint.
# This file overrides /etc/ghost/model.env when the NixOS module provides it.
GHOST_API_URL=http://127.0.0.1:11434/v1/chat/completions

# Model name exposed by the configured server.
GHOST_MODEL=replace-with-local-model

# Optional for authenticated remote endpoints. Never commit the real key.
# GHOST_API_KEY=

# Optional request timeout in seconds.
GHOST_API_TIMEOUT=120
