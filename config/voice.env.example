# This file overrides /etc/ghost/voice.env when the NixOS module provides it.
GHOST_WHISPER_MODEL=/path/to/ggml-base.en.bin
GHOST_WHISPER_THREADS=4
GHOST_WHISPER_LANGUAGE=en
GHOST_WHISPER_PROMPT="GHOST, NixOS, Niri, Quickshell, PipeWire, Ollama."
GHOST_WHISPER_NO_SPEECH_THRESHOLD=0.50

GHOST_PIPER_MODEL=/path/to/voice.onnx
GHOST_PIPER_CONFIG=/path/to/voice.onnx.json

GHOST_RECORD_SECONDS=6
GHOST_AUDIO_MIN_PEAK_DB=-45
GHOST_VOICE_MODEL=qwen3:4b-instruct
GHOST_VOICE_MAX_TOKENS=128
GHOST_VOICE_HISTORY_MESSAGES=6
GHOST_SMART_MODEL=qwen3:8b
GHOST_SMART_MAX_TOKENS=256
GHOST_SMART_HISTORY_MESSAGES=12
GHOST_PROPOSAL_MAX_TOKENS=384
GHOST_PROPOSAL_TIMEOUT=240
GHOST_APPROVAL_TTL_SECONDS=900
GHOST_VOICE_ROUTE=auto
GHOST_SMART_QUERY_LENGTH=180

# Optional PipeWire node ID or name. Inspect choices with: ghost audio
# GHOST_AUDIO_SOURCE=
# GHOST_AUDIO_SINK=
