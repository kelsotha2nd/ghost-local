#!/usr/bin/env bash

SOURCE="${BASH_SOURCE[0]}"

while [ -L "$SOURCE" ]; do
    DIR="$(cd -P "$(dirname "$SOURCE")" >/dev/null 2>&1 && pwd)"
    SOURCE="$(readlink "$SOURCE")"

    [[ "$SOURCE" != /* ]] && SOURCE="$DIR/$SOURCE"
done

SCRIPT_DIR="$(cd -P "$(dirname "$SOURCE")" >/dev/null 2>&1 && pwd)"
ROOT="$(dirname "$SCRIPT_DIR")"

case "${1:-}" in
    ask)
        shift
        exec "$ROOT/lib/ask" "$@"
        ;;
    context)
        exec "$ROOT/lib/context"
        ;;
    history)
        exec "$ROOT/lib/history"
        ;;
    clear)
        exec "$ROOT/lib/clear"
        ;;
    remember)
        shift
        exec "$ROOT/lib/remember" "$@"
        ;;
    memories)
        exec "$ROOT/lib/memories"
        ;;
    listen)
        shift
        exec "$ROOT/lib/listen" "$@"
        ;;
    speak)
        shift
        exec "$ROOT/lib/speak" "$@"
        ;;
    voice)
        shift
        exec "$ROOT/lib/voice" "$@"
        ;;
    session)
        shift
        exec "$ROOT/lib/session" "$@"
        ;;
    presence)
        shift
        exec "$ROOT/lib/presence" "$@"
        ;;
    route)
        shift
        exec "$ROOT/lib/route" --display "$@"
        ;;
    inspect)
        shift
        exec "$ROOT/lib/inspect" "$@"
        ;;
    propose)
        shift
        exec "$ROOT/lib/propose" "$@"
        ;;
    proposal)
        exec "$ROOT/lib/proposal"
        ;;
    approve)
        shift
        exec "$ROOT/lib/approve" "$@"
        ;;
    stage)
        shift
        exec "$ROOT/lib/stage" "$@"
        ;;
    execute)
        shift
        exec "$ROOT/lib/challenge" "$@"
        ;;
    authorize)
        shift
        if [ "${1:-}" = "activation" ]; then
            export GHOST_AUTHORIZE_ACTIVATE=1
        elif [ "${1:-}" = "rollback" ]; then
            export GHOST_AUTHORIZE_ROLLBACK=1
        else
            export GHOST_AUTHORIZE_EXECUTE=1
        fi
        exec "$ROOT/lib/authorize" "$@"
        ;;
    shadow)
        shift
        exec "$ROOT/lib/shadow" "$@"
        ;;
    verify)
        shift
        exec "$ROOT/lib/verify" "$@"
        ;;
    activation)
        shift
        exec "$ROOT/lib/activation-challenge" "$@"
        ;;
    activate)
        shift
        exec "$ROOT/lib/activate" "$@"
        ;;
    rollback)
        shift
        exec "$ROOT/lib/rollback-challenge" "$@"
        ;;
    capability)
        shift
        exec "$ROOT/lib/capability" "$@"
        ;;
    project)
        shift
        exec "$ROOT/lib/project" "$@"
        ;;
    workload)
        shift
        exec "$ROOT/lib/workload" "$@"
        ;;
    task)
        shift
        exec "$ROOT/lib/task" "$@"
        ;;
    audio)
        exec "$ROOT/lib/audio"
        ;;
    benchmark)
        shift
        exec "$ROOT/lib/benchmark" "$@"
        ;;
    help|-h|--help)
        cat <<'EOF'
GHOST // COMMANDS

  ghost                 show current machine state
  ghost ask <question>  ask GHOST using live machine context
  ghost context         inspect the context GHOST can see
  ghost history         show recent conversation
  ghost clear           clear conversation history
  ghost remember <fact> store a deliberate long-term memory
  ghost memories        show deliberate memories
  ghost listen [seconds|--auto] push-to-talk, timed, or speech-ended transcription
  ghost speak <text>    speak text through the local voice
  ghost voice [seconds|--auto] capture, answer, and speak
  ghost session [seconds|--auto|--wake] keep the voice pipeline resident between turns
  ghost presence start  run the guarded wake session as a user service
  ghost presence status inspect the resident voice presence
  ghost presence stop   stop the resident voice presence
  ghost presence log    show recent resident voice events
  ghost route <request> inspect automatic voice routing
  ghost inspect <target> run a whitelisted read-only inspection
  ghost propose <change> create and save a change proposal
  ghost proposal        review the active proposal
  ghost approve <id>    approve a proposal without executing it
  ghost stage [id]      approve and challenge the active proposal
  ghost execute <id>    issue a deliberate execution challenge
  ghost authorize execution <id> authorize the locked executor
  ghost shadow [package] test execution on an isolated config clone
  ghost verify <id>     fully evaluate an executed change without activation
  ghost activation [id] issue a system activation challenge
  ghost authorize activation authorize and run a challenged activation
  ghost activate <id>   run an already-authorized activation
  ghost rollback        challenge rollback of the latest activation
  ghost authorize rollback authorize and run a challenged rollback
  ghost capability list inspect installed action capabilities
  ghost project inspect inspect the current registered Git project
  ghost project search <text> search tracked project files
  ghost project test    run the exact registered project test
  ghost project diagnose [question] test and diagnose with the smart model
  ghost project prepare <change> create and test an isolated AI patch
  ghost project patch   review the latest prepared patch
  ghost project apply   authorize and apply the prepared patch
  ghost workload status inspect the heavy-job governor
  ghost workload check  check resources for heavy local work
  ghost workload cancel request cancellation of the active heavy job
  ghost task start <work> start one persistent, safely prepared project task
  ghost task status     inspect what GHOST is currently working on
  ghost task result     summarize the current task outcome
  ghost task log        show the durable current-task worker log
  ghost task continue   resume or review the current task
  ghost task cancel     cancel the current task and invalidate its patch
  ghost audio           inspect audio devices and selection
  ghost benchmark [model] measure local model throughput
  ghost help            show this message
EOF
        exit 0
        ;;
    "")
        ;;
    *)
        echo "GHOST // unknown command: $1" >&2
        echo "run 'ghost help' for available commands" >&2
        exit 2
        ;;
esac

echo "========================"
echo " GHOST // ONLINE"
echo "========================"
echo

echo "IDENTITY:"
echo "  user: $(whoami)"
echo "  host: $(hostname)"
echo

for sensor in system resources desktop network storage power nix memory project status; do
    sensor_path="$ROOT/sensors/$sensor"

    if [ -x "$sensor_path" ]; then
        "$sensor_path" || echo "  sensor fault: $sensor"
    else
        printf '%s:\n  sensor offline\n' "${sensor^^}"
    fi

    echo
done
