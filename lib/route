#!/usr/bin/env bash

SOURCE="${BASH_SOURCE[0]}"
ROOT="$(cd -P "$(dirname "$SOURCE")/.." >/dev/null 2>&1 && pwd)"
# shellcheck source=voice-config
source "$ROOT/lib/voice-config"

display=0
if [ "${1:-}" = "--display" ]; then
    display=1
    shift
fi

mode="${GHOST_VOICE_ROUTE:-auto}"
query="$*"
lower="${query,,}"
lane="fast"
reason="conversation"
intent="conversation"

if [[ "$lower" =~ (wipe|erase|destroy|format[[:space:]]+(the[[:space:]]+)?(disk|drive|filesystem)|factory[[:space:]]+reset|reset[[:space:]]+--hard|delete[[:space:]]+(all|every|the[[:space:]]+system)) ]]; then
    intent="protected-change"
elif [[ "$lower" =~ (fix|repair|implement|refactor|configure|rollback|restore|install|uninstall|remove|upgrade|update|deploy|commit|push|add|create|edit|modify|change|restart|enable|disable|rebuild[[:space:]]+(my|the|this|nixos|system|machine|configuration)|run[[:space:]]+(a[[:space:]]+)?rebuild|write[[:space:]]+(a|the|some)?[[:space:]]*(code|script|module|config)) ]]; then
    intent="change"
elif [[ "$lower" =~ (check|inspect|show|list|status|diagnos|debug|troubleshoot|investigat|analy[sz]e|audit|explain|service|daemon|systemd|ollama|process|why[[:space:]]|what[[:space:]]+is|how[[:space:]]+much) ]]; then
    intent="inspect"
fi

case "$mode" in
    fast|smart)
        lane="$mode"
        reason="manual override"
        ;;
    auto)
        if [[ "$intent" = "change" || "$intent" = "protected-change" ]]; then
            lane="smart"
            reason="machine action"
        elif [[ "$lower" =~ (smart[[:space:]]+mode|use[[:space:]]+(the[[:space:]]+)?(smart|bigger|8b)[[:space:]]+model|think[[:space:]]+(hard|carefully|deeply)|take[[:space:]]+your[[:space:]]+time) ]]; then
            lane="smart"
            reason="explicit request"
        elif [[ "$lower" =~ (fix|debug|diagnos|troubleshoot|investigat|repair|implement|refactor|configure|rebuild|rollback|restore|install|uninstall|upgrade|deploy|commit|push|audit|secure|optimi[sz]e|benchmark|plan|design|add|create|edit|modify|change|write[[:space:]]+(a|the|some)?[[:space:]]*(code|script|module|config)) ]]; then
            lane="smart"
            reason="technical work"
        elif [[ "$lower" =~ (why[[:space:]]|how[[:space:]]+should|compare|analy[sz]e|explain|recommend|best[[:space:]]+way|trade.?off|root[[:space:]]+cause|step.?by.?step|what[[:space:]]+should[[:space:]]+we[[:space:]]+(do|build|change)) ]]; then
            lane="smart"
            reason="deeper reasoning"
        elif (( ${#query} >= ${GHOST_SMART_QUERY_LENGTH:-180} )); then
            lane="smart"
            reason="complex request"
        fi
        ;;
    *)
        echo "GHOST // GHOST_VOICE_ROUTE must be auto, fast, or smart" >&2
        exit 2
        ;;
esac

if [ "$mode" = "auto" ] && [ "$lane" = "fast" ] && [ "$intent" = "inspect" ]; then
    reason="read-only lookup"
fi

if (( display )); then
    if [ "$lane" = "smart" ]; then
        model="${GHOST_SMART_MODEL:-qwen3:8b}"
    else
        model="${GHOST_VOICE_MODEL:-qwen3:4b-instruct}"
    fi
    case "$intent" in
        change) gate="confirmation required" ;;
        protected-change) gate="explicit confirmation + validation" ;;
        *) gate="none" ;;
    esac
    printf 'GHOST // ROUTE: %s — %s\n  model:  %s\n  intent: %s\n  gate:   %s\n' \
        "${lane^^}" "$reason" "$model" "$intent" "$gate"
else
    printf '%s\t%s\t%s\n' "$lane" "$reason" "$intent"
fi
