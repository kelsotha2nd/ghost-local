#!/usr/bin/env bash

GHOST_SYSTEM_VOICE_CONFIG="/etc/ghost/voice.env"
GHOST_LOCAL_VOICE_CONFIG="$ROOT/config/voice.env"

if [ -r "$GHOST_SYSTEM_VOICE_CONFIG" ]; then
    # Generated by the NixOS GHOST runtime module.
    # shellcheck source=/dev/null
    source "$GHOST_SYSTEM_VOICE_CONFIG"
fi

if [ -r "$GHOST_LOCAL_VOICE_CONFIG" ]; then
    # Trusted local override; intentionally not committed.
    # shellcheck source=/dev/null
    source "$GHOST_LOCAL_VOICE_CONFIG"
fi
