#!/usr/bin/env bash

set -o pipefail
SOURCE="${BASH_SOURCE[0]}"; ROOT="$(cd -P "$(dirname "$SOURCE")/.." >/dev/null 2>&1 && pwd)"

runner="$ROOT/lib/voice"
if [ "${GHOST_SESSION_TEST_MODE:-0}" = 1 ]; then
    runner="${GHOST_SESSION_VOICE_RUNNER:-}"
    case "$runner" in /tmp/*) [ -x "$runner" ] || exit 21 ;; *) exit 21 ;; esac
fi
failure_limit="${GHOST_SESSION_FAILURE_LIMIT:-3}"
[[ "$failure_limit" =~ ^[1-9]$ ]] || { echo "GHOST // session failure limit must be between 1 and 9" >&2; exit 2; }
wake_required=0; capture_args=("$@")
if [ "${1:-}" = --wake ]; then wake_required=1; capture_args=(--auto); fi

running=1
trap 'running=0' INT TERM
echo "GHOST // SESSION ONLINE"
if [ "$wake_required" -eq 1 ]; then
    echo "  automatic speech endpoint + local wake gate active"
elif [ "${1:-}" = --auto ]; then
    echo "  automatic speech endpoint active"
else
    echo "  push ENTER to close each capture"
fi
echo "  say: Ghost, go quiet"
if [ "${GHOST_SESSION_ANNOUNCE:-1}" = 1 ]; then
    "$ROOT/lib/speak" "Voice session online." || true
fi

failures=0
while [ "$running" -eq 1 ]; do
    GHOST_SESSION_MODE=1 GHOST_WAKE_REQUIRED="$wake_required" "$runner" "${capture_args[@]}"
    voice_status=$?
    case "$voice_status" in
        0) failures=0 ;;
        66) failures=0 ;;
        65) echo "GHOST // SESSION OFFLINE"; exit 0 ;;
        130|143) break ;;
        *)
            failures=$((failures + 1))
            echo "GHOST // SESSION FAULT: voice pipeline exited $voice_status ($failures/$failure_limit)" >&2
            if [ "$failures" -ge "$failure_limit" ]; then
                echo "GHOST // SESSION HALTED — repeated voice failures" >&2
                exit "$voice_status"
            fi
            ;;
    esac
done
echo "GHOST // SESSION OFFLINE"
