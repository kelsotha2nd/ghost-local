#!/usr/bin/env bash

set -o pipefail
SOURCE="${BASH_SOURCE[0]}"
ROOT="$(cd -P "$(dirname "$SOURCE")/.." >/dev/null 2>&1 && pwd)"
# shellcheck source=state
source "$ROOT/lib/state"

proposal_id="${1:-}"
[ -n "$proposal_id" ] || { echo "usage: ghost rollback <proposal-id>" >&2; exit 2; }
test_mode="${GHOST_ROLLBACK_TEST_MODE:-0}"
if [ "$test_mode" = 1 ]; then
    case "$GHOST_NIX_CONFIG_PATH" in /tmp/*) ;; *) echo "GHOST // rollback fixture must live beneath /tmp" >&2; exit 21 ;; esac
else
    [ "$GHOST_NIX_CONFIG_PATH" = "$HOME/.config/nixos/configuration.nix" ] &&
        [ "$GHOST_NIX_GHOST_MODULE_PATH" = "$HOME/.config/nixos/modules/ghost.nix" ] || {
        echo "GHOST // production rollback target mismatch" >&2; exit 20;
    }
    for dependency in nixos-rebuild sudo tee; do command -v "$dependency" >/dev/null || { echo "GHOST // missing dependency: $dependency" >&2; exit 3; }; done
fi

generation_number() {
    local target
    target="$(readlink /nix/var/nix/profiles/system 2>/dev/null || true)"
    if [[ "$target" =~ system-([0-9]+)-link$ ]]; then printf '%s\n' "${BASH_REMATCH[1]}"; else printf '%s\n' unknown; fi
}

ghost_state_init
[ -s "$GHOST_PROPOSAL_FILE" ] && [ -s "$GHOST_ROLLBACK_CHALLENGE_FILE" ] || { echo "GHOST // rollback state unavailable" >&2; exit 4; }
{
    flock -x 9
    stored_id="$(jq -r '.id // empty' "$GHOST_PROPOSAL_FILE")"
    status="$(jq -r '.status // empty' "$GHOST_PROPOSAL_FILE")"
    digest="$(jq -r '.digest // empty' "$GHOST_PROPOSAL_FILE")"
    expected_before="$(jq -r '.activation.generation_after // empty' "$GHOST_PROPOSAL_FILE")"
    expected_after="$(jq -r '.activation.generation_before // empty' "$GHOST_PROPOSAL_FILE")"
    backup="$(jq -r '.execution.backup // empty' "$GHOST_PROPOSAL_FILE")"
    target_path="$(jq -r '.execution.target_path // .machine_fingerprint.config.path' "$GHOST_PROPOSAL_FILE")"
    original_sha256="$(jq -r '.execution.original_sha256 // .machine_fingerprint.config.sha256 // empty' "$GHOST_PROPOSAL_FILE")"
    post_sha256="$(jq -r '.execution.post_sha256 // empty' "$GHOST_PROPOSAL_FILE")"
    original_mode="$(jq -r '.execution.original_mode // empty' "$GHOST_PROPOSAL_FILE")"
    module_sha256="$(jq -r '.machine_fingerprint.ghost_module.sha256 // empty' "$GHOST_PROPOSAL_FILE")"
    auth_expiry="$(jq -r '.rollback_authorization.expires_epoch // 0' "$GHOST_PROPOSAL_FILE")"
    challenge_id="$(jq -r '.proposal_id // empty' "$GHOST_ROLLBACK_CHALLENGE_FILE")"
    challenge_digest="$(jq -r '.digest // empty' "$GHOST_ROLLBACK_CHALLENGE_FILE")"
    challenge_consumed="$(jq -r '.consumed // false' "$GHOST_ROLLBACK_CHALLENGE_FILE")"
    [ "$proposal_id" = "$stored_id" ] && [ "$proposal_id" = "$challenge_id" ] || { echo "GHOST // rollback proposal mismatch" >&2; exit 5; }
    [ "$status" = rollback-authorized ] || { echo "GHOST // system rollback is not authorized" >&2; exit 6; }
    [ "$digest" = "$challenge_digest" ] && [ "$challenge_consumed" = true ] || { echo "GHOST // consumed rollback challenge mismatch" >&2; exit 7; }
    [ "$(date +%s)" -lt "$auth_expiry" ] || { echo "GHOST // rollback authorization expired" >&2; exit 8; }
    [ -f "$backup" ] && [ ! -L "$backup" ] && [ "$(ghost_file_fingerprint "$backup")" = "$original_sha256" ] || { echo "GHOST // trusted rollback backup mismatch" >&2; exit 9; }
    ghost_execution_files_match "$GHOST_PROPOSAL_FILE" || { echo "GHOST // machine files changed; rollback refused" >&2; exit 10; }
    current_generation="${GHOST_TEST_CURRENT_GENERATION:-$(generation_number)}"
    [ "$current_generation" = "$expected_before" ] || { echo "GHOST // active generation changed; rollback refused" >&2; exit 11; }
    case "$target_path" in "$GHOST_NIX_CONFIG_PATH"|"$GHOST_NIX_GHOST_MODULE_PATH") ;; *) echo "GHOST // untrusted rollback target" >&2; exit 10 ;; esac
    cp -p "$backup" "$target_path"; chmod "$original_mode" "$target_path"
    [ "$(ghost_file_fingerprint "$target_path")" = "$original_sha256" ] || { echo "GHOST // CRITICAL: configuration restore mismatch" >&2; exit 12; }
    started_at="$(date --iso-8601=seconds)"
    temporary="$(mktemp "$GHOST_STATE_DIR/.proposal.XXXXXX")"
    jq --arg started_at "$started_at" '.status = "rollback-running" | .rollback = {started_at: $started_at, result: "running"}' "$GHOST_PROPOSAL_FILE" > "$temporary"
    chmod 600 "$temporary"; mv "$temporary" "$GHOST_PROPOSAL_FILE"
} 9> "$GHOST_STATE_LOCK"

rollback_log="$GHOST_STATE_DIR/rollback-${proposal_id}.log"
if [ "$test_mode" = 1 ]; then
    if [ "${GHOST_TEST_ROLLBACK_RESULT:-success}" = success ]; then command_status=0; actual_after="$expected_after"; else command_status=1; actual_after="$expected_before"; fi
else
    echo "GHOST // RESTORING PREVIOUS NIXOS GENERATION"
    echo "  sudo: normal interactive authentication may be requested"
    sudo nixos-rebuild switch --rollback 2>&1 | tee "$rollback_log"
    command_status=${PIPESTATUS[0]}; chmod 600 "$rollback_log"; actual_after="$(generation_number)"
fi

finished_at="$(date --iso-8601=seconds)"; result=failed; new_status=rollback-failed-config-restored
if [ "$command_status" -eq 0 ] && [ "$actual_after" = "$expected_after" ]; then
    if [ "$test_mode" = 1 ] || [ "$(readlink -f /run/current-system 2>/dev/null)" = "$(readlink -f /nix/var/nix/profiles/system 2>/dev/null)" ]; then
        result=passed; new_status=fixture-rolled-back; [ "$test_mode" = 1 ] || new_status=rolled-back
    else result=current-system-mismatch; new_status=rollback-ambiguous; fi
elif [ "$command_status" -eq 0 ]; then result=unexpected-generation; new_status=rollback-ambiguous; fi
{
    flock -x 9
    temporary="$(mktemp "$GHOST_STATE_DIR/.proposal.XXXXXX")"
    jq --arg status "$new_status" --arg finished_at "$finished_at" --arg result "$result" --arg before "$expected_before" --arg after "$actual_after" \
        --argjson exit_status "$command_status" --arg log "$rollback_log" \
        '.status = $status | .rollback += {finished_at: $finished_at, result: $result, exit_status: $exit_status, generation_before: $before, generation_after: $after, log: $log, configuration_restored: true}' \
        "$GHOST_PROPOSAL_FILE" > "$temporary"
    chmod 600 "$temporary"; mv "$temporary" "$GHOST_PROPOSAL_FILE"
    jq -cn --arg event "$new_status" --arg proposal_id "$proposal_id" --arg result "$result" --arg before "$expected_before" --arg after "$actual_after" \
        '{event: $event, proposal_id: $proposal_id, result: $result, generation_before: $before, generation_after: $after, configuration_restored: true}' >> "$GHOST_APPROVAL_AUDIT_FILE"
} 9> "$GHOST_STATE_LOCK"

if [ "$new_status" = rolled-back ] || [ "$new_status" = fixture-rolled-back ]; then
    echo "GHOST // SYSTEM ROLLBACK COMPLETE"
    echo "  generation:    $expected_before -> $actual_after"
    echo "  configuration: trusted backup restored"
    exit 0
fi
echo "GHOST // ROLLBACK NOT VERIFIED — configuration backup was restored" >&2
echo "  result:     $result" >&2
echo "  generation: $expected_before -> $actual_after" >&2
exit 13
