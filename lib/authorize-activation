#!/usr/bin/env bash

set -o pipefail

SOURCE="${BASH_SOURCE[0]}"
ROOT="$(cd -P "$(dirname "$SOURCE")/.." >/dev/null 2>&1 && pwd)"
# shellcheck source=state
source "$ROOT/lib/state"
ghost_state_init

if [ ! -s "$GHOST_PROPOSAL_FILE" ] || [ ! -s "$GHOST_ACTIVATION_CHALLENGE_FILE" ]; then
    echo "GHOST // active system activation challenge unavailable" >&2
    exit 4
fi

{
    flock -x 9
    proposal_id="$(jq -r '.id // empty' "$GHOST_PROPOSAL_FILE")"
    status="$(jq -r '.status // empty' "$GHOST_PROPOSAL_FILE")"
    digest="$(jq -r '.digest // empty' "$GHOST_PROPOSAL_FILE")"
    post_sha256="$(jq -r '.execution.post_sha256 // empty' "$GHOST_PROPOSAL_FILE")"
    module_sha256="$(jq -r '.machine_fingerprint.ghost_module.sha256 // empty' "$GHOST_PROPOSAL_FILE")"
    challenge_id="$(jq -r '.proposal_id // empty' "$GHOST_ACTIVATION_CHALLENGE_FILE")"
    challenge_digest="$(jq -r '.digest // empty' "$GHOST_ACTIVATION_CHALLENGE_FILE")"
    challenge_expiry="$(jq -r '.expires_epoch // 0' "$GHOST_ACTIVATION_CHALLENGE_FILE")"
    challenge_consumed="$(jq -r 'if has("consumed") then .consumed else true end' \
        "$GHOST_ACTIVATION_CHALLENGE_FILE")"
    nonce="$(jq -r '.nonce // empty' "$GHOST_ACTIVATION_CHALLENGE_FILE")"

    case "$status" in
        validated-awaiting-activation|fixture-validated) ;;
        *) echo "GHOST // proposal is not eligible for activation" >&2; exit 6 ;;
    esac
    [ "$proposal_id" = "$challenge_id" ] && [ "$digest" = "$challenge_digest" ] || {
        echo "GHOST // activation challenge binding mismatch" >&2
        exit 5
    }
    [ "$challenge_consumed" = "false" ] && [ -n "$nonce" ] || {
        echo "GHOST // activation challenge already consumed" >&2
        exit 7
    }
    [ "$(date +%s)" -lt "$challenge_expiry" ] || {
        echo "GHOST // activation challenge expired" >&2
        exit 8
    }
    [ "$(ghost_file_fingerprint "$GHOST_NIX_CONFIG_PATH")" = "$post_sha256" ] && \
        [ "$(ghost_file_fingerprint "$GHOST_NIX_GHOST_MODULE_PATH")" = "$module_sha256" ] || {
        echo "GHOST // validated files changed; activation refused" >&2
        exit 9
    }

    authorized_at="$(date --iso-8601=seconds)"
    nonce_sha256="$(printf '%s' "$nonce" | sha256sum | awk '{print $1}')"
    temporary="$(mktemp "$GHOST_STATE_DIR/.proposal.XXXXXX")"
    jq --arg authorized_at "$authorized_at" --arg nonce_sha256 "$nonce_sha256" \
        --argjson expires_epoch "$challenge_expiry" \
        '.status = "activation-authorized" |
         .activation_authorization = {authorized_at: $authorized_at,
             expires_epoch: $expires_epoch, nonce_sha256: $nonce_sha256}' \
        "$GHOST_PROPOSAL_FILE" > "$temporary"
    chmod 600 "$temporary"
    mv "$temporary" "$GHOST_PROPOSAL_FILE"

    consumed="$(mktemp "$GHOST_STATE_DIR/.activation.XXXXXX")"
    jq 'del(.nonce) | .consumed = true' "$GHOST_ACTIVATION_CHALLENGE_FILE" > "$consumed"
    chmod 600 "$consumed"
    mv "$consumed" "$GHOST_ACTIVATION_CHALLENGE_FILE"
    jq -cn --arg event "activation-authorized" --arg proposal_id "$proposal_id" \
        --arg digest "$digest" --arg authorized_at "$authorized_at" \
        --arg nonce_sha256 "$nonce_sha256" --argjson expires_epoch "$challenge_expiry" \
        '{event: $event, proposal_id: $proposal_id, digest: $digest,
          authorized_at: $authorized_at, expires_epoch: $expires_epoch,
          nonce_sha256: $nonce_sha256, activation: "not-run"}' \
        >> "$GHOST_APPROVAL_AUDIT_FILE"
} 9> "$GHOST_STATE_LOCK"

echo "GHOST // SYSTEM ACTIVATION AUTHORIZED"
echo "  proposal:   $proposal_id"
if [ "${GHOST_AUTHORIZE_ACTIVATE:-0}" = "1" ]; then
    echo
    exec "$ROOT/lib/activate" "$proposal_id"
fi
echo "  activation: not run (authorization only)"
