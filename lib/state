#!/usr/bin/env bash

GHOST_STATE_DIR="${GHOST_STATE_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/ghost}"
GHOST_HISTORY_FILE="$GHOST_STATE_DIR/history.jsonl"
GHOST_MEMORY_FILE="$GHOST_STATE_DIR/memories.jsonl"
GHOST_PROPOSAL_FILE="$GHOST_STATE_DIR/proposal.json"
GHOST_APPROVAL_AUDIT_FILE="$GHOST_STATE_DIR/approvals.jsonl"
GHOST_APPROVAL_CREDENTIAL_FILE="$GHOST_STATE_DIR/approval.credential.json"
GHOST_STATE_LOCK="$GHOST_STATE_DIR/state.lock"
GHOST_NIX_CONFIG_PATH="${GHOST_NIX_CONFIG_PATH:-$HOME/.config/nixos/configuration.nix}"
GHOST_NIX_GHOST_MODULE_PATH="${GHOST_NIX_GHOST_MODULE_PATH:-$HOME/.config/nixos/modules/ghost.nix}"

ghost_state_init() {
    umask 077
    mkdir -p "$GHOST_STATE_DIR"
    chmod 700 "$GHOST_STATE_DIR"
    touch "$GHOST_HISTORY_FILE" "$GHOST_MEMORY_FILE" "$GHOST_APPROVAL_AUDIT_FILE" "$GHOST_STATE_LOCK"
    chmod 600 "$GHOST_HISTORY_FILE" "$GHOST_MEMORY_FILE" \
        "$GHOST_APPROVAL_AUDIT_FILE" "$GHOST_STATE_LOCK"
}

ghost_file_fingerprint() {
    local target="$1"
    if [ -r "$target" ]; then
        sha256sum "$target" | awk '{print $1}'
    else
        echo "unavailable"
    fi
}

ghost_machine_fingerprint() {
    jq -cn \
        --arg config_path "$GHOST_NIX_CONFIG_PATH" \
        --arg config_sha256 "$(ghost_file_fingerprint "$GHOST_NIX_CONFIG_PATH")" \
        --arg module_path "$GHOST_NIX_GHOST_MODULE_PATH" \
        --arg module_sha256 "$(ghost_file_fingerprint "$GHOST_NIX_GHOST_MODULE_PATH")" \
        '{config: {path: $config_path, sha256: $config_sha256},
          ghost_module: {path: $module_path, sha256: $module_sha256}}'
}

ghost_proposal_save() {
    local request="$1"
    local intent="$2"
    local plan="$3"
    local proposal_id created_at temporary digest fingerprint
    proposal_id="$(date +%Y%m%d-%H%M%S)"
    created_at="$(date --iso-8601=seconds)"
    digest="$(printf '%s\0%s\0%s' "$request" "$intent" "$plan" | sha256sum | awk '{print $1}')"
    fingerprint="$(ghost_machine_fingerprint)"
    temporary="$(mktemp "$GHOST_STATE_DIR/.proposal.XXXXXX")"

    jq -n --arg id "$proposal_id" --arg created_at "$created_at" \
        --arg request "$request" --arg intent "$intent" --arg plan "$plan" \
        --arg digest "$digest" --argjson fingerprint "$fingerprint" \
        '{id: $id, created_at: $created_at, status: "pending-review",
          intent: $intent, request: $request, plan: $plan, digest: $digest,
          machine_fingerprint: $fingerprint, approval: null}' > "$temporary"
    chmod 600 "$temporary"
    {
        flock -x 9
        mv "$temporary" "$GHOST_PROPOSAL_FILE"
    } 9> "$GHOST_STATE_LOCK"
    printf '%s\n' "$proposal_id"
}

ghost_history_append() {
    local role="$1"
    local content="$2"
    local timestamp
    timestamp="$(date --iso-8601=seconds)"

    {
        flock -x 9
        jq -cn --arg created_at "$timestamp" --arg role "$role" \
            --arg content "$content" \
            '{created_at: $created_at, role: $role, content: $content}' \
            >> "$GHOST_HISTORY_FILE"
    } 9> "$GHOST_STATE_LOCK"
}

ghost_memory_append() {
    local content="$1"
    local timestamp
    timestamp="$(date --iso-8601=seconds)"

    {
        flock -x 9
        jq -cn --arg created_at "$timestamp" --arg content "$content" \
            '{created_at: $created_at, content: $content}' \
            >> "$GHOST_MEMORY_FILE"
    } 9> "$GHOST_STATE_LOCK"
}
