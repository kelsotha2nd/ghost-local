#!/usr/bin/env bash

SOURCE="${BASH_SOURCE[0]}"
ROOT="$(cd -P "$(dirname "$SOURCE")/.." >/dev/null 2>&1 && pwd)"
# shellcheck source=state
source "$ROOT/lib/state"
SYSTEM_MODEL_CONFIG="/etc/ghost/model.env"
MODEL_CONFIG="$ROOT/config/model.env"

if [ -r "$SYSTEM_MODEL_CONFIG" ]; then
    # Generated by the NixOS GHOST runtime module.
    # shellcheck source=/dev/null
    source "$SYSTEM_MODEL_CONFIG"
fi

if [ -r "$MODEL_CONFIG" ]; then
    # Trusted local override; intentionally not committed.
    # shellcheck source=/dev/null
    source "$MODEL_CONFIG"
fi

question="$*"
if [ -z "$question" ]; then
    echo "usage: ghost ask <question>" >&2
    exit 2
fi

for dependency in curl jq flock; do
    if ! command -v "$dependency" >/dev/null 2>&1; then
        echo "GHOST // missing dependency: $dependency" >&2
        exit 3
    fi
done

ghost_state_init

api_url="${GHOST_API_URL:-http://127.0.0.1:11434/v1/chat/completions}"
model="${GHOST_MODEL:-}"
max_tokens="${GHOST_MAX_TOKENS:-384}"
history_messages="${GHOST_HISTORY_MESSAGES:-12}"

if [ -z "$model" ]; then
    cat >&2 <<'EOF'
GHOST // model not configured

Copy config/model.env.example to config/model.env and set GHOST_MODEL.
The default endpoint expects an OpenAI-compatible server on localhost:11434.
EOF
    exit 3
fi

if [[ ! "$max_tokens" =~ ^[1-9][0-9]*$ ]]; then
    echo "GHOST // GHOST_MAX_TOKENS must be a positive integer" >&2
    exit 3
fi

if [[ ! "$history_messages" =~ ^[1-9][0-9]*$ ]]; then
    echo "GHOST // GHOST_HISTORY_MESSAGES must be a positive integer" >&2
    exit 3
fi

history="[]"
if [ -s "$GHOST_HISTORY_FILE" ]; then
    history="$(tail -n "$history_messages" "$GHOST_HISTORY_FILE" |
        jq -s '[.[] | {role: .role, content: .content}]')"
fi

context_args=()
if [ "${GHOST_CONTEXT_MODE:-full}" = "compact" ]; then
    context_args+=(--compact)
fi
context="$("$ROOT/lib/context" "${context_args[@]}" "$question")"
system_prompt="${context}

=== RESPONSE RULES ===
Answer as GHOST. Ground claims about the machine only in the supplied live state
and memory. Say when information is unavailable. Be concise unless detail is
requested. Never claim to have run an action that was not actually performed.
Treat RAM, swap, filesystem storage, and machine memory as distinct concepts;
never substitute storage figures for a question about RAM.
Conversation history is continuity, not evidence about current machine state.
When history conflicts with LIVE STATE, always use LIVE STATE.
Protect the machine's privacy, security, reliability, and maintainability.
Diagnose before proposing changes. Do not treat a request for advice as
authorization to modify the system, and never mistake capability for permission."

if [ "${GHOST_SPEAK_RESPONSE:-0}" = "1" ]; then
    system_prompt="${system_prompt}
This response will be spoken aloud. Use plain conversational text without
Markdown, lists, headings, code fences, emoji, or stage directions."
fi

payload="$(jq -n \
    --arg model "$model" \
    --arg system "$system_prompt" \
    --arg question "$question" \
    --argjson max_tokens "$max_tokens" \
    --argjson history "$history" \
    '{model: $model, stream: true, reasoning_effort: "none",
      temperature: 0.6, max_tokens: $max_tokens,
      messages: ([{role: "system", content: $system}] + $history +
        [{role: "user", content: $question}])}')"

headers=(-H "Content-Type: application/json")
if [ -n "${GHOST_API_KEY:-}" ]; then
    headers+=(-H "Authorization: Bearer $GHOST_API_KEY")
fi

printf 'GHOST:\n'

answer_file="$(mktemp)"
trap 'rm -f "$answer_file"' EXIT
model_started="$(date +%s%3N)"

curl --silent --show-error --fail-with-body --no-buffer \
    --max-time "${GHOST_API_TIMEOUT:-120}" \
    "${headers[@]}" --data "$payload" "$api_url" |
    while IFS= read -r line; do
        [[ "$line" == data:* ]] || continue
        event="${line#data: }"
        [ "$event" = "[DONE]" ] && break
        jq -jr '.choices[0].delta.content // empty' <<< "$event" 2>/dev/null
    done | tee "$answer_file"
pipeline_status=("${PIPESTATUS[@]}")
model_finished="$(date +%s%3N)"
printf '\n'

if (( pipeline_status[0] != 0 )); then
    echo "GHOST // model backend unreachable at $api_url" >&2
    exit 4
fi

if (( pipeline_status[1] != 0 )); then
    echo "GHOST // could not decode model response" >&2
    exit 5
fi

if (( pipeline_status[2] != 0 )); then
    echo "GHOST // could not persist model response" >&2
    exit 5
fi

answer="$(<"$answer_file")"
if [ -z "$answer" ]; then
    echo "GHOST // model backend returned no visible answer" >&2
    exit 6
fi

ghost_history_append "user" "$question"
ghost_history_append "assistant" "$answer"

if [ "${GHOST_SHOW_TIMING:-0}" = "1" ]; then
    printf '  model:      %.1fs\n' "$((model_finished - model_started))e-3" >&2
fi

if [ "${GHOST_SPEAK_RESPONSE:-0}" = "1" ]; then
    "$ROOT/lib/speak" "$answer" || echo "GHOST // spoken output failed" >&2
fi
