#!/usr/bin/env bash

SOURCE="${BASH_SOURCE[0]}"
ROOT="$(cd -P "$(dirname "$SOURCE")/.." >/dev/null 2>&1 && pwd)"
SYSTEM_MODEL_CONFIG="/etc/ghost/model.env"
MODEL_CONFIG="$ROOT/config/model.env"

if [ -r "$SYSTEM_MODEL_CONFIG" ]; then
    # Generated by the NixOS GHOST runtime module.
    # shellcheck source=/dev/null
    source "$SYSTEM_MODEL_CONFIG"
fi

if [ -r "$MODEL_CONFIG" ]; then
    # Trusted local override; intentionally not committed.
    # shellcheck source=/dev/null
    source "$MODEL_CONFIG"
fi

question="$*"
if [ -z "$question" ]; then
    echo "usage: ghost ask <question>" >&2
    exit 2
fi

for dependency in curl jq; do
    if ! command -v "$dependency" >/dev/null 2>&1; then
        echo "GHOST // missing dependency: $dependency" >&2
        exit 3
    fi
done

api_url="${GHOST_API_URL:-http://127.0.0.1:11434/v1/chat/completions}"
model="${GHOST_MODEL:-}"
max_tokens="${GHOST_MAX_TOKENS:-384}"

if [ -z "$model" ]; then
    cat >&2 <<'EOF'
GHOST // model not configured

Copy config/model.env.example to config/model.env and set GHOST_MODEL.
The default endpoint expects an OpenAI-compatible server on localhost:11434.
EOF
    exit 3
fi

if [[ ! "$max_tokens" =~ ^[1-9][0-9]*$ ]]; then
    echo "GHOST // GHOST_MAX_TOKENS must be a positive integer" >&2
    exit 3
fi

context="$("$ROOT/lib/context")"
system_prompt="${context}

=== RESPONSE RULES ===
Answer as GHOST. Ground claims about the machine only in the supplied live state
and memory. Say when information is unavailable. Be concise unless detail is
requested. Never claim to have run an action that was not actually performed."

payload="$(jq -n \
    --arg model "$model" \
    --arg system "$system_prompt" \
    --arg question "$question" \
    --argjson max_tokens "$max_tokens" \
    '{model: $model, stream: true, reasoning_effort: "none",
      temperature: 0.6, max_tokens: $max_tokens, messages: [
        {role: "system", content: $system},
        {role: "user", content: $question}
    ]}')"

headers=(-H "Content-Type: application/json")
if [ -n "${GHOST_API_KEY:-}" ]; then
    headers+=(-H "Authorization: Bearer $GHOST_API_KEY")
fi

printf 'GHOST:\n'

curl --silent --show-error --fail-with-body --no-buffer \
    --max-time "${GHOST_API_TIMEOUT:-120}" \
    "${headers[@]}" --data "$payload" "$api_url" |
    while IFS= read -r line; do
        [[ "$line" == data:* ]] || continue
        event="${line#data: }"
        [ "$event" = "[DONE]" ] && break
        jq -jr '.choices[0].delta.content // empty' <<< "$event" 2>/dev/null
    done
pipeline_status=("${PIPESTATUS[@]}")
printf '\n'

if (( pipeline_status[0] != 0 )); then
    echo "GHOST // model backend unreachable at $api_url" >&2
    exit 4
fi

if (( pipeline_status[1] != 0 )); then
    echo "GHOST // could not decode model response" >&2
    exit 5
fi
