#!/usr/bin/env bash

SOURCE="${BASH_SOURCE[0]}"
ROOT="$(cd -P "$(dirname "$SOURCE")/.." >/dev/null 2>&1 && pwd)"
transcript="$*"
command="${transcript,,}"
command="${command%[.!?]}"

if [[ "$command" =~ ^(ghost[,[:space:]]+)?(what[[:space:]]+are[[:space:]]+you[[:space:]]+working[[:space:]]+on|task[[:space:]]+status)$ ]]; then
    "$ROOT/lib/task" status
    exit $?
fi

if [[ "$command" =~ ^(ghost[,[:space:]]+)?(continue[[:space:]]+(the[[:space:]]+)?current[[:space:]]+task|continue[[:space:]]+task)$ ]]; then
    "$ROOT/lib/task" continue
    exit $?
fi

if [[ "$command" =~ ^(ghost[,[:space:]]+)?(cancel[[:space:]]+(the[[:space:]]+)?current[[:space:]]+task|cancel[[:space:]]+task)$ ]]; then
    "$ROOT/lib/task" cancel
    exit $?
fi

if [[ "$command" =~ ^(ghost[,[:space:]]+)?work[[:space:]]+on[[:space:]]+ghost:[[:space:]]+(.+)$ ]]; then
    "$ROOT/lib/task" start "${BASH_REMATCH[2]}"
    exit $?
fi

if [[ "$command" =~ ^(ghost[,[:space:]]+)?authorize[[:space:]]+prepared[[:space:]]+patch$ ]]; then
    GHOST_AUTHORIZE_PROJECT_APPLY="${GHOST_VOICE_COMMAND_PROJECT_APPLY:-1}" \
        "$ROOT/lib/project-authorize-apply" || exit $?
    if [ "${GHOST_VOICE_COMMAND_SPEAK:-0}" = "1" ]; then
        "$ROOT/lib/speak" "The prepared patch is applied and the project tests pass. No commit was created." || true
    fi
    exit 0
fi

if [[ "$command" =~ ^(ghost[,[:space:]]+)?prepare[[:space:]]+system[[:space:]]+rollback$ ]]; then
    "$ROOT/lib/rollback-challenge" || exit $?
    if [ "${GHOST_VOICE_COMMAND_SPEAK:-0}" = "1" ]; then
        "$ROOT/lib/speak" "Rollback is prepared. Nothing has changed. To restore the trusted configuration and previous generation, say authorize system rollback." || true
    fi
    exit 0
fi

if [[ "$command" =~ ^(ghost[,[:space:]]+)?authorize[[:space:]]+system[[:space:]]+rollback$ ]]; then
    GHOST_AUTHORIZE_ROLLBACK="${GHOST_VOICE_COMMAND_ROLLBACK:-1}" \
        "$ROOT/lib/authorize-rollback" || exit $?
    if [ "${GHOST_VOICE_COMMAND_SPEAK:-0}" = "1" ]; then
        "$ROOT/lib/speak" "The trusted configuration and previous NixOS generation are restored." || true
    fi
    exit 0
fi

if [[ "$command" =~ ^(ghost[,[:space:]]+)?authorize[[:space:]]+system[[:space:]]+activation$ ]]; then
    GHOST_AUTHORIZE_ACTIVATE="${GHOST_VOICE_COMMAND_ACTIVATE:-1}" \
        "$ROOT/lib/authorize-activation" || exit $?
    if [ "${GHOST_VOICE_COMMAND_SPEAK:-0}" = "1" ]; then
        "$ROOT/lib/speak" "The validated NixOS configuration is active." || true
    fi
    exit 0
fi

if [[ "$command" =~ ^(ghost[,[:space:]]+)?stage[[:space:]]+this[[:space:]]+proposal$ ]]; then
    "$ROOT/lib/stage" || exit $?
    if [ "${GHOST_VOICE_COMMAND_SPEAK:-0}" = "1" ]; then
        # shellcheck source=state
        source "$ROOT/lib/state"; ghost_state_init
        capability_id="$(jq -r '.capability.id // empty' "$GHOST_PROPOSAL_FILE")"
        if [ "$capability_id" = service.restart ]; then
            "$ROOT/lib/speak" "The service restart is staged. Nothing has executed. To restart the verified unit, say authorize service restart." || true
        elif [ "$capability_id" = service.enable ] || [ "$capability_id" = service.disable ]; then
            "$ROOT/lib/speak" "The declarative service change is staged. Nothing has executed. To edit and evaluate the verified option, say authorize service change." || true
        elif [ "$capability_id" = nix.option.set-boolean ]; then
            "$ROOT/lib/speak" "The registered Nix option change is staged. Nothing has executed. To edit and evaluate the signed boolean, say authorize Nix option change." || true
        else
            "$ROOT/lib/speak" "The active proposal is staged. Nothing has executed. To perform the backed-up configuration edit without rebuilding, say authorize package edit." || true
        fi
    fi
    exit 0
fi

if [[ "$command" =~ ^(ghost[,[:space:]]+)?authorize[[:space:]]+nix[[:space:]]+option[[:space:]]+change$ ]]; then
    # shellcheck source=state
    source "$ROOT/lib/state"; ghost_state_init
    [ "$(jq -r '.capability.id // empty' "$GHOST_PROPOSAL_FILE")" = nix.option.set-boolean ] || {
        echo "GHOST // active proposal is not a registered Nix option change" >&2; exit 6;
    }
    proposal_id="$(jq -r '.id // empty' "$GHOST_PROPOSAL_FILE")"
    GHOST_AUTHORIZE_EXECUTE="${GHOST_VOICE_COMMAND_EXECUTE:-1}" "$ROOT/lib/authorize" execution "$proposal_id" || exit $?
    if [ "${GHOST_VOICE_COMMAND_SPEAK:-0}" = "1" ]; then
        "$ROOT/lib/speak" "The registered Nix option was edited and fully evaluated. To activate it, say authorize system activation." || true
    fi
    exit 0
fi

if [[ "$command" =~ ^(ghost[,[:space:]]+)?authorize[[:space:]]+service[[:space:]]+change$ ]]; then
    # shellcheck source=state
    source "$ROOT/lib/state"; ghost_state_init
    capability_id="$(jq -r '.capability.id // empty' "$GHOST_PROPOSAL_FILE")"
    case "$capability_id" in service.enable|service.disable) ;; *) echo "GHOST // active proposal is not a declarative service change" >&2; exit 6 ;; esac
    proposal_id="$(jq -r '.id // empty' "$GHOST_PROPOSAL_FILE")"
    GHOST_AUTHORIZE_EXECUTE="${GHOST_VOICE_COMMAND_EXECUTE:-1}" "$ROOT/lib/authorize" execution "$proposal_id" || exit $?
    if [ "${GHOST_VOICE_COMMAND_SPEAK:-0}" = "1" ]; then
        "$ROOT/lib/speak" "The service configuration was edited and fully evaluated. To activate it, say authorize system activation." || true
    fi
    exit 0
fi

if [[ "$command" =~ ^(ghost[,[:space:]]+)?authorize[[:space:]]+service[[:space:]]+restart$ ]]; then
    # shellcheck source=state
    source "$ROOT/lib/state"; ghost_state_init
    [ "$(jq -r '.capability.id // empty' "$GHOST_PROPOSAL_FILE")" = service.restart ] || {
        echo "GHOST // active proposal is not a service restart" >&2; exit 6;
    }
    proposal_id="$(jq -r '.id // empty' "$GHOST_PROPOSAL_FILE")"
    GHOST_AUTHORIZE_EXECUTE="${GHOST_VOICE_COMMAND_EXECUTE:-1}" \
        "$ROOT/lib/authorize" execution "$proposal_id" || exit $?
    if [ "${GHOST_VOICE_COMMAND_SPEAK:-0}" = "1" ]; then
        "$ROOT/lib/speak" "The verified service restarted and returned active." || true
    fi
    exit 0
fi

if [[ "$command" =~ ^(ghost[,[:space:]]+)?authorize[[:space:]]+package[[:space:]]+edit$ ]]; then
    # shellcheck source=state
    source "$ROOT/lib/state"
    ghost_state_init
    if [ ! -s "$GHOST_EXECUTION_CHALLENGE_FILE" ]; then
        echo "GHOST // active execution challenge unavailable" >&2
        exit 4
    fi
    proposal_id="$(jq -r '.proposal_id // empty' "$GHOST_EXECUTION_CHALLENGE_FILE")"
    capability_id="$(jq -r '.capability.id // empty' "$GHOST_PROPOSAL_FILE")"
    case "$capability_id" in package.add|package.remove|"") ;; *) echo "GHOST // active proposal is not a package edit" >&2; exit 6 ;; esac
    GHOST_AUTHORIZE_EXECUTE="${GHOST_VOICE_COMMAND_EXECUTE:-1}" \
        "$ROOT/lib/authorize" execution "$proposal_id" || exit $?
    if [ "${GHOST_VOICE_COMMAND_SPEAK:-0}" = "1" ]; then
        "$ROOT/lib/speak" "The package edit completed with backup and full NixOS validation. System activation has not run. To switch to the validated configuration, say authorize system activation." || true
    fi
    exit 0
fi

if [[ "$command" =~ ^(ghost[,[:space:]]+)?execute[[:space:]]+approved[[:space:]]+proposal[[:space:]]+([0-9-]+)$ ]]; then
    proposal_id="${BASH_REMATCH[2]}"
    "$ROOT/lib/challenge" "$proposal_id" || exit $?
    if [ "${GHOST_VOICE_COMMAND_SPEAK:-0}" = "1" ]; then
        "$ROOT/lib/speak" "Execution challenge issued for proposal ${proposal_id}. Nothing has executed. Say authorize execution ${proposal_id} to continue." || true
    fi
    exit 0
fi

if [[ "$command" =~ ^(ghost[,[:space:]]+)?authorize[[:space:]]+execution[[:space:]]+([0-9-]+)$ ]]; then
    proposal_id="${BASH_REMATCH[2]}"
    GHOST_AUTHORIZE_EXECUTE="${GHOST_VOICE_COMMAND_EXECUTE:-1}" \
        "$ROOT/lib/authorize" execution "$proposal_id" || exit $?
    if [ "${GHOST_VOICE_COMMAND_SPEAK:-0}" = "1" ]; then
        "$ROOT/lib/speak" "Execution completed for proposal ${proposal_id}. The configuration edit was backed up and validated. System activation has not run." || true
    fi
    exit 0
fi

exit 64
