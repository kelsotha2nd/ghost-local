#!/usr/bin/env bash

set -o pipefail
SOURCE="${BASH_SOURCE[0]}"
ROOT="$(cd -P "$(dirname "$SOURCE")/.." >/dev/null 2>&1 && pwd)"
# shellcheck source=state
source "$ROOT/lib/state"
ghost_state_init

[ -s "$GHOST_PROPOSAL_FILE" ] || { echo "GHOST // activated proposal unavailable" >&2; exit 4; }
{
    flock -x 9
    proposal_id="$(jq -r '.id // empty' "$GHOST_PROPOSAL_FILE")"
    status="$(jq -r '.status // empty' "$GHOST_PROPOSAL_FILE")"
    digest="$(jq -r '.digest // empty' "$GHOST_PROPOSAL_FILE")"
    before="$(jq -r '.activation.generation_before // empty' "$GHOST_PROPOSAL_FILE")"
    after="$(jq -r '.activation.generation_after // empty' "$GHOST_PROPOSAL_FILE")"
    backup="$(jq -r '.execution.backup // empty' "$GHOST_PROPOSAL_FILE")"
    original_sha256="$(jq -r '.execution.original_sha256 // .machine_fingerprint.config.sha256 // empty' "$GHOST_PROPOSAL_FILE")"
    case "$status" in activated|fixture-activated) ;; *) echo "GHOST // latest proposal is not an activated change" >&2; exit 6 ;; esac
    [ -n "$before" ] && [ -n "$after" ] && [ "$before" != "$after" ] || { echo "GHOST // activation generations are invalid" >&2; exit 7; }
    [ -f "$backup" ] && [ ! -L "$backup" ] && [ "$(ghost_file_fingerprint "$backup")" = "$original_sha256" ] || {
        echo "GHOST // trusted rollback backup unavailable" >&2; exit 8;
    }
    ghost_execution_files_match "$GHOST_PROPOSAL_FILE" || {
        echo "GHOST // configuration changed since activation; rollback refused" >&2; exit 9;
    }
    ttl="${GHOST_ROLLBACK_CHALLENGE_TTL_SECONDS:-120}"
    [[ "$ttl" =~ ^[1-9][0-9]*$ ]] || { echo "GHOST // invalid rollback challenge TTL" >&2; exit 3; }
    now="$(date +%s)"; expires="$((now + ttl))"
    created_at="$(date --iso-8601=seconds)"; expires_at="$(date --date="@$expires" --iso-8601=seconds)"
    nonce="$(od -An -N16 -tx1 /dev/urandom | tr -d ' \n')"
    temporary="$(mktemp "$GHOST_STATE_DIR/.rollback.XXXXXX")"
    jq -cn --arg proposal_id "$proposal_id" --arg digest "$digest" --arg before "$before" --arg after "$after" \
        --arg nonce "$nonce" --arg created_at "$created_at" --arg expires_at "$expires_at" --argjson expires_epoch "$expires" \
        '{proposal_id: $proposal_id, digest: $digest, generation_before: $before, generation_after: $after,
          nonce: $nonce, created_at: $created_at, expires_at: $expires_at, expires_epoch: $expires_epoch, consumed: false}' > "$temporary"
    chmod 600 "$temporary"; mv "$temporary" "$GHOST_ROLLBACK_CHALLENGE_FILE"
} 9> "$GHOST_STATE_LOCK"

echo "GHOST // SYSTEM ROLLBACK CHALLENGE ISSUED — nothing changed"
echo "  generation: $after -> $before"
echo "  expires:    $expires_at"
echo "  action:     restore trusted configuration backup and previous generation"
echo
echo "To authorize rollback, say exactly:"
echo "authorize system rollback"
