#!/usr/bin/env bash

SOURCE="${BASH_SOURCE[0]}"
ROOT="$(cd -P "$(dirname "$SOURCE")/.." >/dev/null 2>&1 && pwd)"
# shellcheck source=voice-config
source "$ROOT/lib/voice-config"

export GHOST_SHOW_TIMING=1

raw_transcript="$("$ROOT/lib/listen" "${1:-}")" || exit $?
transcript="$("$ROOT/lib/normalize" "$raw_transcript")"
if [ "$transcript" != "$raw_transcript" ]; then
    echo "GHOST // NORMALIZED: $transcript"
fi
echo "YOU: $transcript"

GHOST_VOICE_COMMAND_SPEAK=1 "$ROOT/lib/voice-command" "$transcript"
voice_command_status=$?
if [ "$voice_command_status" -eq 0 ]; then
    exit 0
elif [ "$voice_command_status" -ne 64 ]; then
    exit "$voice_command_status"
fi

IFS=$'\t' read -r lane route_reason request_intent < <("$ROOT/lib/route" "$transcript") || exit $?
export GHOST_REQUEST_INTENT="$request_intent"
if [ "$lane" = "smart" ]; then
    export GHOST_MODEL_OVERRIDE="${GHOST_SMART_MODEL:-qwen3:8b}"
    export GHOST_MAX_TOKENS="${GHOST_SMART_MAX_TOKENS:-256}"
    export GHOST_HISTORY_MESSAGES="${GHOST_SMART_HISTORY_MESSAGES:-12}"
    export GHOST_CONTEXT_MODE="full"
else
    export GHOST_MODEL_OVERRIDE="${GHOST_VOICE_MODEL:-qwen3:4b-instruct}"
    export GHOST_MAX_TOKENS="${GHOST_VOICE_MAX_TOKENS:-128}"
    export GHOST_HISTORY_MESSAGES="${GHOST_VOICE_HISTORY_MESSAGES:-6}"
    export GHOST_CONTEXT_MODE="compact"
fi

printf 'GHOST // ROUTE: %s — %s\n' "${lane^^}" "$route_reason"
if [[ "$request_intent" = *change ]]; then
    printf 'GHOST // SAFETY GATE: %s — approval required before execution\n' \
        "${request_intent^^}"
    export GHOST_PROPOSAL_MODE=1
    export GHOST_SAVE_PROPOSAL=1
    export GHOST_MAX_TOKENS="${GHOST_PROPOSAL_MAX_TOKENS:-384}"
    export GHOST_CONTEXT_MODE="compact"
    export GHOST_API_TIMEOUT="${GHOST_PROPOSAL_TIMEOUT:-240}"
fi

if [ "$request_intent" = "inspect" ] || [[ "$request_intent" = *change ]]; then
    tool_context="$("$ROOT/lib/inspect" --auto "$transcript")"
    if [ -n "$tool_context" ]; then
        export GHOST_TOOL_CONTEXT="$tool_context"
        echo "GHOST // TOOLS: read-only evidence attached"
    fi
fi
GHOST_SPEAK_RESPONSE=1 exec "$ROOT/lib/ask" "$transcript"
