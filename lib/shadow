#!/usr/bin/env bash

set -euo pipefail

SOURCE="${BASH_SOURCE[0]}"
ROOT="$(cd -P "$(dirname "$SOURCE")/.." >/dev/null 2>&1 && pwd)"
package="${1:-htop}"

if [[ ! "$package" =~ ^[a-z0-9][a-z0-9+._-]*$ ]]; then
    echo "GHOST // invalid package attribute: $package" >&2
    exit 2
fi

source_config="${GHOST_SHADOW_SOURCE_CONFIG:-$HOME/.config/nixos/configuration.nix}"
source_module="${GHOST_SHADOW_SOURCE_MODULE:-$HOME/.config/nixos/modules/ghost.nix}"
if [ ! -f "$source_config" ] || [ -L "$source_config" ] || \
    [ ! -f "$source_module" ] || [ -L "$source_module" ]; then
    echo "GHOST // shadow sources must be regular, non-symlink files" >&2
    exit 3
fi

shadow_root="$(mktemp -d /tmp/ghost-shadow.XXXXXX)"
cleanup() {
    case "$shadow_root" in
        /tmp/ghost-shadow.*) rm -r -- "$shadow_root" ;;
        *) echo "GHOST // unsafe shadow cleanup target refused: $shadow_root" >&2 ;;
    esac
}
trap cleanup EXIT

source_config_sha256="$(sha256sum "$source_config" | awk '{print $1}')"
source_module_sha256="$(sha256sum "$source_module" | awk '{print $1}')"
source_config_mode="$(stat -c '%a' "$source_config")"
source_module_mode="$(stat -c '%a' "$source_module")"

export GHOST_STATE_DIR="$shadow_root/state"
export GHOST_NIX_CONFIG_PATH="$shadow_root/configuration.nix"
export GHOST_NIX_GHOST_MODULE_PATH="$shadow_root/ghost.nix"
cp -p "$source_config" "$GHOST_NIX_CONFIG_PATH"
cp -p "$source_module" "$GHOST_NIX_GHOST_MODULE_PATH"

# shellcheck source=state
source "$ROOT/lib/state"
ghost_state_init

plan="Scope: add pkgs.${package} to the shadow configuration. Steps: create a
backup, edit the package list, and parse the result. Risk: fixture only.
Validation: exact Nix syntax parse. Rollback: restore exact bytes and mode.
Pending review."

echo "GHOST // SHADOW EXECUTION"
echo "  source:  $source_config"
echo "  package: $package"
echo "  target:  isolated /tmp clone"
echo

proposal_id="$(ghost_proposal_save \
    "add ${package} to configuration.nix" "change" "$plan")"
"$ROOT/lib/approve" "$proposal_id" >/dev/null
"$ROOT/lib/challenge" "$proposal_id" >/dev/null
"$ROOT/lib/authorize" execution "$proposal_id" >/dev/null
GHOST_EXECUTOR_TEST_MODE=1 "$ROOT/lib/execute" "$proposal_id"

cp -p "$source_config" "$GHOST_NIX_CONFIG_PATH"
rollback_id="$(ghost_proposal_save \
    "add ${package} to configuration.nix" "change" "$plan")"
"$ROOT/lib/approve" "$rollback_id" >/dev/null
"$ROOT/lib/challenge" "$rollback_id" >/dev/null
"$ROOT/lib/authorize" execution "$rollback_id" >/dev/null
before_failure_sha256="$(sha256sum "$GHOST_NIX_CONFIG_PATH" | awk '{print $1}')"
before_failure_mode="$(stat -c '%a' "$GHOST_NIX_CONFIG_PATH")"

set +e
GHOST_EXECUTOR_TEST_MODE=1 GHOST_FORCE_VALIDATION_FAILURE=1 \
    "$ROOT/lib/execute" "$rollback_id" >/dev/null 2>&1
rollback_status=$?
set -e

if [ "$rollback_status" -ne 16 ]; then
    echo "GHOST // shadow rollback test returned unexpected status: $rollback_status" >&2
    exit 4
fi
after_failure_sha256="$(sha256sum "$GHOST_NIX_CONFIG_PATH" | awk '{print $1}')"
after_failure_mode="$(stat -c '%a' "$GHOST_NIX_CONFIG_PATH")"
if [ "$before_failure_sha256" != "$after_failure_sha256" ] || \
    [ "$before_failure_mode" != "$after_failure_mode" ]; then
    echo "GHOST // shadow rollback did not restore exact content and mode" >&2
    exit 5
fi

if [ "$source_config_sha256" != "$(sha256sum "$source_config" | awk '{print $1}')" ] || \
    [ "$source_module_sha256" != "$(sha256sum "$source_module" | awk '{print $1}')" ] || \
    [ "$source_config_mode" != "$(stat -c '%a' "$source_config")" ] || \
    [ "$source_module_mode" != "$(stat -c '%a' "$source_module")" ]; then
    echo "GHOST // source configuration changed during shadow execution" >&2
    exit 6
fi

echo
echo "GHOST // SHADOW VALIDATED"
echo "  successful edit: passed"
echo "  syntax parse:    passed"
echo "  forced rollback: exact bytes and mode restored"
echo "  real config:     unchanged"
echo "  activation:      unavailable"
