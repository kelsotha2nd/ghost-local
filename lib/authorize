#!/usr/bin/env bash

set -o pipefail

SOURCE="${BASH_SOURCE[0]}"
ROOT="$(cd -P "$(dirname "$SOURCE")/.." >/dev/null 2>&1 && pwd)"
# shellcheck source=state
source "$ROOT/lib/state"

if [ "${1:-}" != "execution" ] || [ -z "${2:-}" ] || [ -n "${3:-}" ]; then
    echo "usage: ghost authorize execution <proposal-id>" >&2
    exit 2
fi
proposal_id="$2"

ghost_state_init
if [ ! -s "$GHOST_PROPOSAL_FILE" ] || \
    [ ! -s "$GHOST_APPROVAL_CREDENTIAL_FILE" ] || \
    [ ! -s "$GHOST_EXECUTION_CHALLENGE_FILE" ]; then
    echo "GHOST // active execution challenge unavailable" >&2
    exit 4
fi

{
    flock -x 9
    stored_id="$(jq -r '.id // empty' "$GHOST_PROPOSAL_FILE")"
    status="$(jq -r '.status // empty' "$GHOST_PROPOSAL_FILE")"
    intent="$(jq -r '.intent // empty' "$GHOST_PROPOSAL_FILE")"
    request="$(jq -r '.request // empty' "$GHOST_PROPOSAL_FILE")"
    plan="$(jq -r '.plan // empty' "$GHOST_PROPOSAL_FILE")"
    digest="$(jq -r '.digest // empty' "$GHOST_PROPOSAL_FILE")"
    approval_expiry="$(jq -r '.approval.expires_epoch // 0' "$GHOST_PROPOSAL_FILE")"
    challenge_id="$(jq -r '.proposal_id // empty' "$GHOST_EXECUTION_CHALLENGE_FILE")"
    challenge_digest="$(jq -r '.digest // empty' "$GHOST_EXECUTION_CHALLENGE_FILE")"
    challenge_expiry="$(jq -r '.expires_epoch // 0' "$GHOST_EXECUTION_CHALLENGE_FILE")"
    nonce="$(jq -r '.nonce // empty' "$GHOST_EXECUTION_CHALLENGE_FILE")"
    challenge_consumed="$(jq -r 'if has("consumed") then .consumed else true end' \
        "$GHOST_EXECUTION_CHALLENGE_FILE")"

    [ "$proposal_id" = "$stored_id" ] && [ "$proposal_id" = "$challenge_id" ] || {
        echo "GHOST // challenge proposal ID mismatch" >&2
        exit 5
    }
    [ "$status" = "approved" ] && [ "$intent" = "change" ] || {
        echo "GHOST // proposal is not eligible for execution authorization" >&2
        exit 6
    }
    [ "$challenge_consumed" = "false" ] && [ -n "$nonce" ] || {
        echo "GHOST // execution challenge already consumed" >&2
        exit 7
    }
    [ "$(date +%s)" -lt "$challenge_expiry" ] || {
        echo "GHOST // execution challenge expired" >&2
        exit 8
    }
    computed_digest="$(printf '%s\0%s\0%s' "$request" "$intent" "$plan" | sha256sum | awk '{print $1}')"
    [ "$computed_digest" = "$digest" ] && [ "$challenge_digest" = "$digest" ] || {
        echo "GHOST // proposal or challenge digest mismatch" >&2
        exit 9
    }
    [ "$(ghost_machine_fingerprint)" = "$(jq -c '.machine_fingerprint' "$GHOST_PROPOSAL_FILE")" ] || {
        echo "GHOST // machine configuration changed; authorization refused" >&2
        exit 10
    }

    credential_id="$(jq -r '.proposal_id // empty' "$GHOST_APPROVAL_CREDENTIAL_FILE")"
    credential_digest="$(jq -r '.digest // empty' "$GHOST_APPROVAL_CREDENTIAL_FILE")"
    credential_expiry="$(jq -r '.expires_epoch // 0' "$GHOST_APPROVAL_CREDENTIAL_FILE")"
    token="$(jq -r '.token // empty' "$GHOST_APPROVAL_CREDENTIAL_FILE")"
    token_sha256="$(printf '%s' "$token" | sha256sum | awk '{print $1}')"
    stored_token_sha256="$(jq -r '.approval.token_sha256 // empty' "$GHOST_PROPOSAL_FILE")"
    if [ "$credential_id" != "$stored_id" ] || [ "$credential_digest" != "$digest" ] || \
        [ "$credential_expiry" != "$approval_expiry" ] || \
        [ "$token_sha256" != "$stored_token_sha256" ]; then
        echo "GHOST // approval credential mismatch; authorization refused" >&2
        exit 11
    fi

    authorized_at="$(date --iso-8601=seconds)"
    nonce_sha256="$(printf '%s' "$nonce" | sha256sum | awk '{print $1}')"
    temporary="$(mktemp "$GHOST_STATE_DIR/.proposal.XXXXXX")"
    jq --arg authorized_at "$authorized_at" \
        --argjson expires_epoch "$challenge_expiry" --arg nonce_sha256 "$nonce_sha256" \
        '.status = "execution-authorized" |
         .execution_authorization = {authorized_at: $authorized_at,
             expires_epoch: $expires_epoch, nonce_sha256: $nonce_sha256}' \
        "$GHOST_PROPOSAL_FILE" > "$temporary"
    chmod 600 "$temporary"
    mv "$temporary" "$GHOST_PROPOSAL_FILE"

    challenge_temporary="$(mktemp "$GHOST_STATE_DIR/.challenge.XXXXXX")"
    jq 'del(.nonce) | .consumed = true' "$GHOST_EXECUTION_CHALLENGE_FILE" \
        > "$challenge_temporary"
    chmod 600 "$challenge_temporary"
    mv "$challenge_temporary" "$GHOST_EXECUTION_CHALLENGE_FILE"

    jq -cn --arg event "execution-authorized" --arg proposal_id "$stored_id" \
        --arg digest "$digest" --arg authorized_at "$authorized_at" \
        --arg nonce_sha256 "$nonce_sha256" --argjson expires_epoch "$challenge_expiry" \
        '{event: $event, proposal_id: $proposal_id, digest: $digest,
          authorized_at: $authorized_at, expires_epoch: $expires_epoch,
          nonce_sha256: $nonce_sha256, execution: "not-run"}' \
        >> "$GHOST_APPROVAL_AUDIT_FILE"
} 9> "$GHOST_STATE_LOCK"

echo "GHOST // EXECUTION AUTHORIZED — executor remains locked"
echo "  proposal: $proposal_id"
echo "  expires:  $(date --date="@${challenge_expiry}" --iso-8601=seconds)"
echo "  execution: not run"
