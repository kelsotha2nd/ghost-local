#!/usr/bin/env bash

SOURCE="${BASH_SOURCE[0]}"
ROOT="$(cd -P "$(dirname "$SOURCE")/.." >/dev/null 2>&1 && pwd)"
# shellcheck source=voice-config
source "$ROOT/lib/voice-config"

auto_mode=0
if [ "${1:-}" = --auto ]; then auto_mode=1; shift; fi
duration="${1:-}"
if [ -n "$duration" ] && [[ ! "$duration" =~ ^[1-9][0-9]*$ ]]; then
    echo "GHOST // recording duration must be a positive integer" >&2
    exit 2
fi

if ! command -v pw-record >/dev/null 2>&1; then
    echo "GHOST // missing voice dependency: pw-record" >&2
    exit 3
fi

audio_file="$(mktemp --suffix=.wav)"
record_log="$(mktemp)"
record_pid=""; ffmpeg_pid=""; audio_fifo=""; audio_dir=""; vad_log=""
cleanup() {
    if [ -n "$record_pid" ] && kill -0 "$record_pid" 2>/dev/null; then
        kill -INT "$record_pid" 2>/dev/null || true
        wait "$record_pid" 2>/dev/null || true
    fi
    if [ -n "$ffmpeg_pid" ] && kill -0 "$ffmpeg_pid" 2>/dev/null; then
        kill -INT "$ffmpeg_pid" 2>/dev/null || true; wait "$ffmpeg_pid" 2>/dev/null || true
    fi
    rm -f "$audio_file" "$record_log" "$audio_fifo" "$vad_log"
    case "$audio_dir" in /tmp/ghost-audio.*) rmdir "$audio_dir" 2>/dev/null || true ;; esac
}
trap cleanup EXIT
trap 'exit 130' INT TERM

record_args=(--rate 16000 --channels 1 --format s16)
if [ -n "${GHOST_AUDIO_SOURCE:-}" ]; then
    record_args+=(--target "$GHOST_AUDIO_SOURCE")
fi

capture_started="$(date +%s%3N)"

if [ "$auto_mode" -eq 1 ]; then
    command -v ffmpeg >/dev/null 2>&1 || { echo "GHOST // missing voice dependency: ffmpeg" >&2; exit 3; }
    [ -z "$duration" ] || { echo "GHOST // --auto does not accept a duration" >&2; exit 2; }
    initial_timeout="${GHOST_AUTO_INITIAL_TIMEOUT_SECONDS:-12}"
    maximum_seconds="${GHOST_AUTO_MAX_SECONDS:-30}"
    silence_seconds="${GHOST_AUTO_SILENCE_SECONDS:-1.3}"
    silence_db="${GHOST_AUTO_SILENCE_DB:--9}"
    [[ "$initial_timeout" =~ ^[1-9][0-9]*$ ]] && [[ "$maximum_seconds" =~ ^[1-9][0-9]*$ ]] &&
        [[ "$silence_seconds" =~ ^[0-9]+([.][0-9]+)?$ ]] && [[ "$silence_db" =~ ^-?[0-9]+([.][0-9]+)?$ ]] || {
            echo "GHOST // invalid automatic capture settings" >&2; exit 2;
        }
    [ "$maximum_seconds" -gt "$initial_timeout" ] || { echo "GHOST // auto maximum must exceed initial timeout" >&2; exit 2; }
    audio_dir="$(mktemp -d /tmp/ghost-audio.XXXXXX)"; chmod 700 "$audio_dir"
    audio_fifo="$audio_dir/capture.raw"; mkfifo -m 600 "$audio_fifo"
    vad_log="$(mktemp)"
    echo "GHOST // LISTENING — automatic speech endpoint" >&2
    ffmpeg -hide_banner -nostats -f s16le -ar 16000 -ac 1 -i "$audio_fifo" \
        -af "silencedetect=noise=${silence_db}dB:d=${silence_seconds}" -c:a pcm_s16le -y "$audio_file" \
        >/dev/null 2>"$vad_log" &
    ffmpeg_pid=$!
    pw-record "${record_args[@]}" --raw - >"$audio_fifo" 2>"$record_log" &
    record_pid=$!
    auto_started="$(date +%s)"; auto_outcome=""
    while kill -0 "$record_pid" 2>/dev/null && kill -0 "$ffmpeg_pid" 2>/dev/null; do
        vad_state="$("$ROOT/lib/vad-state" "$vad_log")"
        elapsed=$(( $(date +%s) - auto_started ))
        if [ "$vad_state" = complete ]; then auto_outcome=complete; break; fi
        if [ "$vad_state" = waiting ] && [ "$elapsed" -ge "$initial_timeout" ]; then auto_outcome=idle; break; fi
        if [ "$elapsed" -ge "$maximum_seconds" ]; then auto_outcome=maximum; break; fi
        sleep 0.1
    done
    kill -INT "$record_pid" 2>/dev/null || true; wait "$record_pid"; record_status=$?; record_pid=""
    wait "$ffmpeg_pid" 2>/dev/null || true; ffmpeg_pid=""
    if [ "${GHOST_AUTO_DEBUG:-0}" = 1 ]; then
        debug_bytes="$(wc -c < "$audio_file" 2>/dev/null || echo 0)"
        debug_peak="$(ffmpeg -hide_banner -nostats -i "$audio_file" -af volumedetect -f null - 2>&1 | awk '/max_volume:/ {print $(NF - 1); exit}')"
        echo "GHOST // AUTO DEBUG" >&2
        echo "  audio bytes: $debug_bytes" >&2
        echo "  peak dB: ${debug_peak:-unavailable}" >&2
        echo "  silence events:" >&2
        if grep -qE 'silence_(start|end):' "$vad_log"; then
            grep -E 'silence_(start|end):' "$vad_log" | tail -n 8 | sed 's/^/    /' >&2
        else
            echo "    none" >&2
        fi
    fi
    if [ "$auto_outcome" = idle ]; then
        echo "GHOST // AUTO: no speech before timeout" >&2
        exit 66
    elif [ "$auto_outcome" = maximum ]; then
        echo "GHOST // AUTO: maximum capture reached" >&2
    else
        echo "GHOST // AUTO: end of speech detected" >&2
    fi
elif [ -n "$duration" ]; then
    echo "GHOST // LISTENING (${duration}s)" >&2
    pw-record "${record_args[@]}" \
        --sample-count "$((duration * 16000))" "$audio_file" \
        >"$record_log" 2>&1
    record_status=$?
elif [ -t 0 ]; then
    echo "GHOST // LISTENING — press ENTER to stop" >&2
    pw-record "${record_args[@]}" "$audio_file" >"$record_log" 2>&1 &
    record_pid=$!
    read -r _
    kill -INT "$record_pid" 2>/dev/null || true
    wait "$record_pid"
    record_status=$?
    record_pid=""
else
    duration="${GHOST_RECORD_SECONDS:-6}"
    echo "GHOST // LISTENING (${duration}s)" >&2
    pw-record "${record_args[@]}" \
        --sample-count "$((duration * 16000))" "$audio_file" \
        >"$record_log" 2>&1
    record_status=$?
fi
record_bytes="$(wc -c < "$audio_file" 2>/dev/null || echo 0)"
capture_finished="$(date +%s%3N)"

# PipeWire may return a non-zero status when a bounded sample count closes the
# stream. A WAV larger than its header is the reliable success condition.
if (( record_bytes <= 44 )); then
    [ -s "$record_log" ] && sed 's/^/  /' "$record_log" >&2
    echo "GHOST // recording failed (pw-record exit $record_status)" >&2
    echo "GHOST // check the default PipeWire input with: wpctl status" >&2
    exit 4
fi

if (( record_status != 0 )); then
    echo "GHOST // capture closed with audio preserved" >&2
fi

if [ ! -r "$audio_file" ]; then
    echo "GHOST // recording failed" >&2
    exit 4
fi

echo "GHOST // TRANSCRIBING" >&2
transcribe_started="$(date +%s%3N)"
transcript="$("$ROOT/lib/transcribe" "$audio_file")" || exit $?
transcribe_finished="$(date +%s%3N)"

if [ "${GHOST_SHOW_TIMING:-0}" = "1" ]; then
    echo "GHOST // TIMING" >&2
    printf '  capture:    %.1fs\n' "$((capture_finished - capture_started))e-3" >&2
    printf '  transcribe: %.1fs\n' "$((transcribe_finished - transcribe_started))e-3" >&2
fi

printf '%s\n' "$transcript"
