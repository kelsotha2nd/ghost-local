#!/usr/bin/env bash

SOURCE="${BASH_SOURCE[0]}"
ROOT="$(cd -P "$(dirname "$SOURCE")/.." >/dev/null 2>&1 && pwd)"
# shellcheck source=state
source "$ROOT/lib/state"
ghost_state_init

if [ ! -s "$GHOST_PROPOSAL_FILE" ]; then
    echo "GHOST // no active proposal"
    exit 0
fi

now_epoch="$(date +%s)"
jq -r --argjson now "$now_epoch" '
    def visible_status:
        if .status == "approved" and (.approval.expires_epoch // 0) <= $now
        then "expired" else .status end;
    "GHOST // ACTIVE PROPOSAL",
    "  id:      \(.id)",
    "  status:  \(visible_status)",
    "  created: \(.created_at)",
    "  intent:  \(.intent)",
    "",
    "REQUEST:",
    .request,
    "",
    "PLAN:",
    .plan,
    (if .approval then "", "APPROVAL:",
        "  approved: \(.approval.approved_at)",
        "  expires:  \(.approval.expires_at)"
     else empty end)
' "$GHOST_PROPOSAL_FILE"
