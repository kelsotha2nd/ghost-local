#!/usr/bin/env bash

SOURCE="${BASH_SOURCE[0]}"
ROOT="$(cd -P "$(dirname "$SOURCE")/.." >/dev/null 2>&1 && pwd)"
# shellcheck source=state
source "$ROOT/lib/state"
ghost_state_init

{
    flock -x 9
    : > "$GHOST_HISTORY_FILE"
} 9> "$GHOST_STATE_LOCK"

echo "GHOST // conversation cleared; deliberate memories preserved"
