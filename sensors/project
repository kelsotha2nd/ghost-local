#!/usr/bin/env bash

SOURCE="${BASH_SOURCE[0]}"
ROOT="$(cd -P "$(dirname "$SOURCE")/.." >/dev/null 2>&1 && pwd)"
if git -C "$PWD" rev-parse --is-inside-work-tree >/dev/null 2>&1 && [ -f "$(git -C "$PWD" rev-parse --show-toplevel)/.ghost/project.json" ]; then
    "$ROOT/lib/project" inspect
else
    echo "PROJECT:"
    echo "  none in current directory"
fi
