#!/usr/bin/env bash

set -euo pipefail
ROOT="$(cd -P "$(dirname "${BASH_SOURCE[0]}")/.." >/dev/null 2>&1 && pwd)"
temporary_root="$(mktemp -d /tmp/ghost-capability-test.XXXXXX)"
trap 'rm -r "$temporary_root"' EXIT
export GHOST_STATE_DIR="$temporary_root/state"
export GHOST_NIX_CONFIG_PATH="$temporary_root/configuration.nix"
export GHOST_NIX_GHOST_MODULE_PATH="$temporary_root/ghost.nix"
printf '%s\n' '{ pkgs, ... }: { environment.systemPackages = with pkgs; [ curl ]; }' > "$GHOST_NIX_CONFIG_PATH"
printf '%s\n' '{ ... }: { }' > "$GHOST_NIX_GHOST_MODULE_PATH"

descriptor="$("$ROOT/lib/capability" resolve 'install the package htop')"
[ "$(jq -r .id <<< "$descriptor")" = package.add ]
[ "$(jq -r .target <<< "$descriptor")" = htop ]
remove_descriptor="$("$ROOT/lib/capability" resolve 'uninstall the package curl')"
[ "$(jq -r .id <<< "$remove_descriptor")" = package.remove ]
[ "$(jq -r .target <<< "$remove_descriptor")" = curl ]
capability_list="$("$ROOT/lib/capability" list)"
grep -q $'^package.add\t' <<< "$capability_list"
grep -q $'^package.remove\t' <<< "$capability_list"
set +e
"$ROOT/lib/capability" resolve 'rewrite my entire desktop' >/dev/null 2>&1
unsupported_status=$?
set -e
[ "$unsupported_status" -eq 4 ]

# shellcheck source=../lib/state
source "$ROOT/lib/state"; ghost_state_init
proposal_id="$(ghost_proposal_save 'install htop' change 'Scope. Steps. Risk. Validation. Rollback. Pending review.' "$descriptor")"
[ "$(jq -r .capability.id "$GHOST_PROPOSAL_FILE")" = package.add ]
[ "$(jq -r .capability.target "$GHOST_PROPOSAL_FILE")" = htop ]

temporary="$(mktemp "$GHOST_STATE_DIR/.proposal.XXXXXX")"
jq '.capability.target = "jq"' "$GHOST_PROPOSAL_FILE" > "$temporary"
mv "$temporary" "$GHOST_PROPOSAL_FILE"
set +e
"$ROOT/lib/approve" "$proposal_id" >/dev/null 2>&1
tamper_status=$?
set -e
[ "$tamper_status" -ne 0 ]
[ "$(jq -r .status "$GHOST_PROPOSAL_FILE")" = pending-review ]

echo "capability tests passed"
