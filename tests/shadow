#!/usr/bin/env bash

set -euo pipefail

ROOT="$(cd -P "$(dirname "${BASH_SOURCE[0]}")/.." >/dev/null 2>&1 && pwd)"
fixture_root="$(mktemp -d /tmp/ghost-shadow-source.XXXXXX)"
trap 'rm -r "$fixture_root"' EXIT
source_config="$fixture_root/configuration.nix"
source_module="$fixture_root/ghost.nix"

printf '%s\n' \
    '{ pkgs, ... }:' \
    '{' \
    '  environment.systemPackages = with pkgs; [' \
    '    curl' \
    '  ];' \
    '}' > "$source_config"
printf '%s\n' '{ ... }: { }' > "$source_module"
before_config="$(sha256sum "$source_config" | awk '{print $1}')"
before_module="$(sha256sum "$source_module" | awk '{print $1}')"

output="$(GHOST_SHADOW_SOURCE_CONFIG="$source_config" \
    GHOST_SHADOW_SOURCE_MODULE="$source_module" \
    GHOST_SHADOW_SKIP_FULL_EVALUATION=1 \
    "$ROOT/lib/shadow" htop)"

[[ "$output" == *"GHOST // SHADOW VALIDATED"* ]]
[[ "$output" == *"forced rollback: exact bytes and mode restored"* ]]
[ "$before_config" = "$(sha256sum "$source_config" | awk '{print $1}')" ]
[ "$before_module" = "$(sha256sum "$source_module" | awk '{print $1}')" ]

echo "shadow tests passed"
