#!/usr/bin/env bash

set -euo pipefail
ROOT="$(cd -P "$(dirname "${BASH_SOURCE[0]}")/.." >/dev/null 2>&1 && pwd)"
temporary_root="$(mktemp -d /tmp/ghost-vad-test.XXXXXX)"; trap 'rm -r "$temporary_root"' EXIT
log="$temporary_root/vad.log"
: > "$log"; [ "$("$ROOT/lib/vad-state" "$log")" = waiting ]
printf '%s\n' '[silencedetect] silence_start: 0' > "$log"; [ "$("$ROOT/lib/vad-state" "$log")" = waiting ]
printf '%s\n' '[silencedetect] silence_end: 2.4 | silence_duration: 2.4' >> "$log"; [ "$("$ROOT/lib/vad-state" "$log")" = speaking ]
printf '%s\n' '[silencedetect] silence_start: 5.7' >> "$log"; [ "$("$ROOT/lib/vad-state" "$log")" = complete ]
printf '%s\n' '[silencedetect] silence_start: 4.2' > "$log"; [ "$("$ROOT/lib/vad-state" "$log")" = complete ]
echo "vad tests passed"
