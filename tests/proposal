#!/usr/bin/env bash

set -euo pipefail

ROOT="$(cd -P "$(dirname "${BASH_SOURCE[0]}")/.." >/dev/null 2>&1 && pwd)"
temporary_state="$(mktemp -d)"
trap 'rm -r "$temporary_state"' EXIT
export GHOST_STATE_DIR="$temporary_state"

# shellcheck source=../lib/state
source "$ROOT/lib/state"
ghost_state_init

proposal_id="$(ghost_proposal_save \
    "update the test configuration" \
    "change" \
    "Scope: test only. Validation: parse. Rollback: revert.")"

[ -n "$proposal_id" ]
[ "$(jq -r '.status' "$GHOST_PROPOSAL_FILE")" = "pending-review" ]
[ "$(jq -r '.intent' "$GHOST_PROPOSAL_FILE")" = "change" ]
proposal_output="$("$ROOT/lib/proposal")"
[[ "$proposal_output" == *"GHOST // ACTIVE PROPOSAL"* ]]
[[ "$proposal_output" == *"update the test configuration"* ]]

valid_plan="$temporary_state/valid-plan"
printf '%s\n' \
    "Scope: test. Steps: inspect then change. Risk: low." \
    "Validation: parse exact target. Rollback: revert. Pending review." \
    > "$valid_plan"
"$ROOT/lib/validate-proposal" "$valid_plan"

invalid_plan="$temporary_state/invalid-plan"
printf '%s\n' \
    "Scope: test. Steps: change <file>. Risk: low." \
    "Validation: nix validate. Rollback: revert. Pending review." \
    > "$invalid_plan"
set +e
"$ROOT/lib/validate-proposal" "$invalid_plan" >/dev/null 2>&1
invalid_status=$?
set -e
[[ "$invalid_status" -eq 1 ]]

package_plan="$temporary_state/package-plan"
printf '%s\n' \
    "Scope: add pkgs.htop. Steps: edit $HOME/.config/nixos/configuration.nix." \
    "Risk: low. Validation: nix-instantiate --parse $HOME/.config/nixos/configuration.nix." \
    "Activation: sudo nixos-rebuild switch -I nixos-config=$HOME/.config/nixos/configuration.nix." \
    "Rollback: revert. Pending review." > "$package_plan"
"$ROOT/lib/validate-proposal" "$package_plan" "add htop to configuration.nix"

with_plan="$temporary_state/with-plan"
printf '%s\n' \
    "Scope: add htop. Steps: edit $HOME/.config/nixos/configuration.nix with pkgs; [ htop ]." \
    "Risk: low. Validation: nix-instantiate --parse $HOME/.config/nixos/configuration.nix." \
    "Activation: sudo nixos-rebuild switch -I nixos-config=$HOME/.config/nixos/configuration.nix." \
    "Rollback: revert. Pending review." > "$with_plan"
"$ROOT/lib/validate-proposal" "$with_plan" "add htop to configuration.nix"
"$ROOT/lib/validate-proposal" "$with_plan" "add the package htop to configuration.nix"

echo "proposal tests passed"
